#include <windows.h>
#include "../include/Resource.h"

IDI_ICON_PANEL ICON "md.ico"
IDB_TOOLBAR_BMP BITMAP "markdown-16x16-solid.bmp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,1,0
PRODUCTVERSION  1,0,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "theneet0"
            VALUE "FileDescription",  "NppMarkdownPanel - Modern Native C++26 Markdown Reader for Notepad++"
            VALUE "FileVersion",      "1.0.1.0"
            VALUE "InternalName",     "NppMarkdownPanel"
            VALUE "LegalCopyright",   "Copyright (c) 2026 theneet0"
            VALUE "OriginalFilename", "NppMarkdownPanel.dll"
            VALUE "ProductName",      "NppMarkdownPanel Native"
            VALUE "ProductVersion",   "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
